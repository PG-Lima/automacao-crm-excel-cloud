# Ambiente da aplicação
APP_ENV=development
APP_DEBUG=false

# Aplicações locais
CRM_BASE_URL=http://127.0.0.1:8000
CLOUD_BASE_URL=http://127.0.0.1:8001

# Automação
PLAYWRIGHT_HEADLESS=true
AUTOMATION_TIMEOUT=30000
PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers

# Armazenamento local
STORAGE_PATH=./storage
DATABASE_PATH=./storage/metadata.db

# Relatórios
REPORT_DEFAULT_DAYS=30

# Logs
LOG_LEVEL=INFO

# Credenciais fictícias do CRM demonstrativo
CRM_DEMO_USERNAME=demo
CRM_DEMO_PASSWORD=demo-only-change-before-running

# Credenciais fictícias da biblioteca
CLOUD_DEMO_USERNAME=cloud-demo
CLOUD_DEMO_PASSWORD=cloud-demo-only-change-before-running